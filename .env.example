# ── Required ───────────────────────────────────────────────
# Bot token from https://discord.com/developers/applications
DISCORD_TOKEN=
# Application (client) ID of the bot
CLIENTID=
# ID of the server the bot runs in (slash commands are registered here)
GUILDID=
# MongoDB connection string and database name
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=octavious

# ── Optional ───────────────────────────────────────────────
# Channel that receives mirrored bot logs (errors, achievement unlocks, ...)
DISCORD_LOG_CHANNEL_ID=
# Separate channel for XP / level-up logs (defaults to DISCORD_LOG_CHANNEL_ID)
DISCORD_LEVEL_LOG_CHANNEL_ID=
# Channel that gets a "<user> joined the server!" message
WELCOME_CHANNEL_ID=

# Achievements: the server's main chat channel, and the channels a member must
# post in to earn the "visit every channel" achievement (comma-separated)
ACHIEVEMENTS_GENERAL_CHANNEL_ID=
ACHIEVEMENTS_CONFIGURED_CHANNEL_IDS=

# YouTube feed for /latest and the bot's "Watching ..." status
YOUTUBE_API_KEY=
# Comma-separated YouTube channel IDs (UC...)
YOUTUBE_CHANNEL_IDS=
